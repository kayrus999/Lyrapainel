local startPosition = UDim2.fromScale(0.5, 0.58)
Main.Position = startPosition
Main.BackgroundTransparency = 1
Overlay.BackgroundTransparency = 1

local openInfo = TweenInfo.new(
	0.55,
	Enum.EasingStyle.Quint,
	Enum.EasingDirection.Out
)

TweenService:Create(
	Main,
	openInfo,
	{
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 0.05
	}
):Play()

TweenService:Create(
	Overlay,
	TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	{
		BackgroundTransparency = 0.35
	}
):Play()

Close.MouseEnter:Connect(function()
	TweenService:Create(
		Close,
		TweenInfo.new(0.15),
		{
			BackgroundColor3 = Color3.fromRGB(190, 55, 65),
			TextColor3 = Color3.fromRGB(255, 255, 255)
		}
	):Play()
end)

Close.MouseLeave:Connect(function()
	TweenService:Create(
		Close,
		TweenInfo.new(0.15),
		{
			BackgroundColor3 = Color3.fromRGB(35, 38, 50),
			TextColor3 = Color3.fromRGB(235, 235, 240)
		}
	):Play()
end)

local closing = false

Close.MouseButton1Click:Connect(function()
	if closing then
		return
	end

	closing = true

	local closeInfo = TweenInfo.new(
		0.4,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.In
	)

	TweenService:Create(
		Main,
		closeInfo,
		{
			Position = UDim2.fromScale(0.5, 0.58),
			BackgroundTransparency = 1
		}
	):Play()

	TweenService:Create(
		Overlay,
		TweenInfo.new(0.35),
		{
			BackgroundTransparency = 1
		}
	):Play()

	task.wait(0.4)
	ScreenGui:Destroy()
end)
