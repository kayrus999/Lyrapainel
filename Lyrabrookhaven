Players.PlayerAdded:Connect(function()
    task.wait(0.5)
    local newList = getPlayersList()
    pcall(function() PlayerDropdown:Set(newList) end)
end)

Players.PlayerRemoving:Connect(function(removedPlayer)
    if SelectedPlayer == removedPlayer then
        SelectedPlayer = nil
    end
    task.wait(0.5)
    local newList = getPlayersList()
    pcall(function() PlayerDropdown:Set(newList) end)
end)

local function IsMyProp(prop)
    if not prop or not prop.Name then return false end
    local propName = prop.Name
    return propName:find("Prop" .. LocalPlayer.Name) or propName:find(LocalPlayer.Name)
end

local function AddPropToFollow(prop)
    if not prop or not prop:FindFirstChild("SetCurrentCFrame") then return end
    for _, existingProp in ipairs(MyProps) do
        if existingProp == prop then return end
    end
    table.insert(MyProps, prop)
end

local function ScanExistingProps()
    local workspaceCom = workspace:FindFirstChild("WorkspaceCom")
    if not workspaceCom then return end
    for _, folder in ipairs(workspaceCom:GetChildren()) do
        if folder:IsA("Folder") or folder:IsA("Model") then
            for _, prop in ipairs(folder:GetChildren()) do
                if IsMyProp(prop) then AddPropToFollow(prop) end
            end
        end
    end
end

local function SetupPropDetection()
    local workspaceCom = workspace:FindFirstChild("WorkspaceCom")
    if not workspaceCom then return end

    local folderConnection = workspaceCom.ChildAdded:Connect(function(folder)
        task.wait(0.05)
        if folder:IsA("Folder") or folder:IsA("Model") then
            local propConnection = folder.ChildAdded:Connect(function(prop)
                task.wait(0.05)
                if IsMyProp(prop) and FollowEnabled then AddPropToFollow(prop) end
            end)
            table.insert(PropDetectionConnections, propConnection)
            for _, prop in ipairs(folder:GetChildren()) do
                if IsMyProp(prop) and FollowEnabled then AddPropToFollow(prop) end
            end
        end
    end)
    table.insert(PropDetectionConnections, folderConnection)

    for _, folder in ipairs(workspaceCom:GetChildren()) do
        if folder:IsA("Folder") or folder:IsA("Model") then
            local propConnection = folder.ChildAdded:Connect(function(prop)
                task.wait(0.05)
                if IsMyProp(prop) and FollowEnabled then AddPropToFollow(prop) end
            end)
            table.insert(PropDetectionConnections, propConnection)
        end
    end
end

local function CleanInvalidProps()
    for i = #MyProps, 1, -1 do
        local prop = MyProps[i]
        if not prop or not prop.Parent or not prop:FindFirstChild("SetCurrentCFrame") then
            table.remove(MyProps, i)
        end
    end
end

local function DisconnectAll()
    if FollowConnection then FollowConnection:Disconnect() FollowConnection = nil end
    if CleanupConnection then CleanupConnection:Disconnect() CleanupConnection = nil end
    if OrbitConnection then OrbitConnection:Disconnect() OrbitConnection = nil end
    for _, conn in ipairs(PropDetectionConnections) do
        if conn then conn:Disconnect() end
    end
    PropDetectionConnections = {}
end

PropTab:AddToggle({
    Name = "Seguir Jogador com Props",
    Default = false,
    Callback = function(Value)
        FollowEnabled = Value

        if FollowEnabled then
            if not SelectedPlayer then
                SendNotification({
                    Title = "Erro",
                    Text = "Nenhum jogador selecionado!",
                    Duration = 5
                })
                return
            end

            MyProps = {}
            ScanExistingProps()
            SetupPropDetection()

            if #MyProps == 0 then
                SendNotification({
                    Title = "Aviso",
                    Text = "Nenhum prop encontrado! Coloque um prop primeiro.",
                    Duration = 5
                })
            else
                SendNotification({
                    Title = "Prop Follower Ativado",
                    Text = #MyProps .. " prop(s) seguindo " .. SelectedPlayer.Name .. "!",
                    Duration = 4
                })
            end

            CleanupConnection = RunService.Heartbeat:Connect(function()
                if tick() % 120 < 0.016 then CleanInvalidProps() end
            end)

            FollowConnection = RunService.Heartbeat:Connect(function()
                if not FollowEnabled then return end

                if not SelectedPlayer or not SelectedPlayer.Parent then
                    SendNotification({
                        Title = "Prop Follower Desativado",
                        Text = "Jogador saiu do servidor!",
                        Duration = 5
                    })
                    FollowEnabled = false
                    DisconnectAll()
                    return
                end

                local targetChar = SelectedPlayer.Character
                if not targetChar then return end

                local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                if not targetRoot then return end

                local propCount = #MyProps
                if propCount == 0 then return end

                for i, prop in ipairs(MyProps) do
                    if prop and prop.Parent and prop:FindFirstChild("SetCurrentCFrame") then
                        local angle = (i - 1) * (360 / propCount)
                        local rad = math.rad(angle)

                        if OrbitEnabled then rad = rad + OrbitAngle end

                        local offsetX = math.sin(rad) * PropDistance
                        local offsetZ = math.cos(rad) * PropDistance

                        local targetPos = targetRoot.Position + Vector3.new(offsetX, PropHeight, offsetZ)
                        local targetCFrame = CFrame.new(targetPos) * CFrame.Angles(
                            math.rad(PropRotationX),
                            rad + math.rad(PropRotationY) + SpinSpeed,
                            math.rad(PropRotationZ)
                        )

                        pcall(function()
                            prop.SetCurrentCFrame:InvokeServer(targetCFrame)
                        end)
                    end
                end
            end)

        else
            DisconnectAll()
            MyProps = {}
        end
    end
})

