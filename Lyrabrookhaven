Message.Position = UDim2.new(0, 30, 0, 140)
Message.Size = UDim2.new(1, -60, 0, 58)
Message.BackgroundTransparency = 1
Message.Text = "Este script foi descontinuado.\nThis script has been discontinued."
Message.TextColor3 = Color3.fromRGB(170, 174, 190)
Message.TextSize = 15
Message.Font = Enum.Font.Gotham
Message.TextWrapped = true
Message.TextXAlignment = Enum.TextXAlignment.Center
Message.TextYAlignment = Enum.TextYAlignment.Center
