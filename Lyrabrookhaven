local function createMusicDropdown(title, musicOptions, default)
    local options = {"Select"}
    for _, sounds in pairs(musicOptions) do
        for _, music in ipairs(sounds) do
            if music.name ~= "" then table.insert(options, music.name) end
        end
    end
    SoundTab:AddDropdown({Name = title, Options = options, Default = Select, Callback = function(v)
        if v == "Select" then return end
        for _, sounds in pairs(musicOptions) do
            for _, music in ipairs(sounds) do
                if music.name == v then tocarMusica(music.id) break end
            end
        end
    end})
end

