local function getPlayersList()
    local list = {}
    table.insert(list, LocalPlayer.Name .. " (Você)")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(list, plr.Name)
        end
    end
    return list
end

local PlayerDropdown = PropTab:AddDropdown({
    Name = "Selecione o jogador alvo",
    Options = getPlayersList(),
    Default = "",
    Callback = function(Value)
        local playerName = Value:gsub(" %(Você%)", "")
        SelectedPlayer = Players:FindFirstChild(playerName)
        if not SelectedPlayer then
            SelectedPlayer = LocalPlayer
        end
        SendNotification({
            Title = "Alvo Selecionado",
            Text = "Props direcionados para: " .. playerName,
            Duration = 3
        })
    end
})

